<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/subtitle"
            android:textColor="@color/ink_muted"
            android:textSize="14sp" />

        <com.emrobinso.cutgridimages.ui.GridPreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/preview_background"
            android:contentDescription="@string/preview_description" />

        <Button
            android:id="@+id/pickButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/canvas"
            android:text="@string/pick_image"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="@string/columns"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/columnsBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/columns" />

            <TextView
                android:id="@+id/columnsValue"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/ink"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="@string/rows"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/rowsBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/rows" />

            <TextView
                android:id="@+id/rowsValue"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/ink"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="@string/format"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/formatGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/formatPng"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/format_png"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/formatJpeg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/format_jpeg"
                    android:textColor="@color/ink" />
            </RadioGroup>
        </LinearLayout>

        <Button
            android:id="@+id/exportButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/accent"
            android:enabled="false"
            android:text="@string/export"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityLiveRegion="polite"
            android:lineSpacingExtra="2dp"
            android:text="@string/hint_start"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
