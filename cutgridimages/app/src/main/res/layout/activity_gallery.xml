<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gallery_title"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/galleryCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/viewListButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:backgroundTint="@color/accent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/view_list"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/viewGrid3Button"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/chip"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/view_grid3"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <Button
            android:id="@+id/viewGrid5Button"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/chip"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/view_grid5"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <Button
            android:id="@+id/selectToggleButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/chip"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/select_mode"
            android:textColor="@color/ink"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ScrollView
            android:id="@+id/galleryScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <GridLayout
                android:id="@+id/galleryGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="1" />
        </ScrollView>

        <TextView
            android:id="@+id/galleryEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/gallery_empty"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/prevPageButton"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:backgroundTint="@color/chip"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/page_prev"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/pageInfoText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/nextPageButton"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:backgroundTint="@color/chip"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/page_next"
            android:textColor="@color/ink"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/selectionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <Button
            android:id="@+id/cancelSelectionButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:backgroundTint="@color/chip"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/cancel"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <Button
            android:id="@+id/deleteSelectedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/danger"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/delete"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/exportSelectedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:backgroundTint="@color/chip"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/save"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <Button
            android:id="@+id/exportAllButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/accent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/export_all"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/galleryStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:textColor="@color/ink_muted"
        android:textSize="12sp" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
