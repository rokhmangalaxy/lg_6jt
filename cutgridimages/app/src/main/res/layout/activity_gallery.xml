<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gallery_title"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/galleryCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Mode tampilan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/viewListButton"
            style="@style/CutGridPillPrimary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/view_list" />

        <Button
            android:id="@+id/viewGrid3Button"
            style="@style/CutGridPillSoft"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/view_grid3" />

        <Button
            android:id="@+id/viewGrid5Button"
            style="@style/CutGridPillSoft"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/view_grid5" />
    </LinearLayout>

    <!-- Pilih + paginasi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/selectToggleButton"
            style="@style/CutGridPillSoft"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="@string/select_mode" />

        <Button
            android:id="@+id/prevPageButton"
            style="@style/CutGridPillSoft"
            android:layout_width="40dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:text="@string/page_prev"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/pageInfoText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/nextPageButton"
            style="@style/CutGridPillSoft"
            android:layout_width="40dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:text="@string/page_next"
            android:textSize="16sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ScrollView
            android:id="@+id/galleryScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <GridLayout
                android:id="@+id/galleryGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="1" />
        </ScrollView>

        <TextView
            android:id="@+id/galleryEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/placeholder_dashed"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/gallery_empty"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/selectionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <Button
            android:id="@+id/cancelSelectionButton"
            style="@style/CutGridPillSoft"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/deleteSelectedButton"
            style="@style/CutGridPillDanger"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/delete" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/exportSelectedButton"
            style="@style/CutGridPillSoft"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/save" />

        <Button
            android:id="@+id/exportAllButton"
            style="@style/CutGridPillPrimary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/export_all" />
    </LinearLayout>

    <TextView
        android:id="@+id/galleryStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:textColor="@color/ink_muted"
        android:textSize="12sp" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
