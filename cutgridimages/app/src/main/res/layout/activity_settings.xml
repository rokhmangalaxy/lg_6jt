<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:text="@string/settings_title"
        android:textColor="@color/ink"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Kartu penamaan berkas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/CutGridLabel"
                    android:text="@string/settings_project" />

                <EditText
                    android:id="@+id/projectNameInput"
                    style="@style/CutGridInput"
                    android:autofillHints="none"
                    android:hint="@string/settings_project_hint"
                    android:inputType="text"
                    android:maxLines="1" />

                <TextView
                    style="@style/CutGridLabel"
                    android:layout_marginTop="14dp"
                    android:text="@string/settings_digits" />

                <EditText
                    android:id="@+id/digitsInput"
                    style="@style/CutGridInput"
                    android:autofillHints="none"
                    android:inputType="number"
                    android:maxLength="1"
                    android:maxLines="1" />

                <TextView
                    style="@style/CutGridLabel"
                    android:layout_marginTop="14dp"
                    android:text="@string/settings_separator" />

                <EditText
                    android:id="@+id/separatorInput"
                    style="@style/CutGridInput"
                    android:autofillHints="none"
                    android:inputType="text"
                    android:maxLength="3"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/namingPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/preview_background"
                    android:padding="12dp"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Kartu warna seleksi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_color"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <GridLayout
                    android:id="@+id/colorGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:columnCount="6" />
            </LinearLayout>

            <!-- Kartu data -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <Button
                    android:id="@+id/saveSettingsButton"
                    style="@style/CutGridPillPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="@string/settings_save" />

                <Button
                    android:id="@+id/clearDataButton"
                    style="@style/CutGridPillSoft"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/danger_soft"
                    android:text="@string/settings_clear"
                    android:textColor="@color/danger" />

                <TextView
                    android:id="@+id/settingsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
