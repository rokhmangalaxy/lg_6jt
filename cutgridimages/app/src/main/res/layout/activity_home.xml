<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Kepala layar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/projectSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/home_subtitle"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Koleksi gambar: 5 kolom, bisa digulir -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card"
        android:padding="8dp">

        <ScrollView
            android:id="@+id/thumbnailScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:visibility="gone">

            <GridLayout
                android:id="@+id/thumbnailGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="5" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/emptyPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/placeholder_dashed"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_empty_title"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="@string/home_empty_hint"
                android:textColor="@color/ink_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Gambar utama + tombol pindah gambar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1">

        <com.emrobinso.cutgridimages.ui.GridEditorView
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/preview_background"
            android:contentDescription="@string/editor_description"
            android:padding="10dp" />

        <ImageButton
            android:id="@+id/prevImageButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/prev_image"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left" />

        <ImageButton
            android:id="@+id/nextImageButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/next_image"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_right" />

        <TextView
            android:id="@+id/imageCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_badge"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:textColor="@color/ink_muted"
            android:textSize="11sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Kontrol mode, grid, dan seleksi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/modeGridButton"
                style="@style/CutGridPillPrimary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/mode_grid" />

            <Button
                android:id="@+id/modeSelectButton"
                style="@style/CutGridPillSoft"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/mode_select" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gridControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_soft"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/columns"
                    android:textColor="@color/ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/columnsMinus"
                    style="@style/CutGridPillSoft"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:backgroundTint="@color/surface"
                    android:text="−"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/columnsValue"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/columnsPlus"
                    style="@style/CutGridPillSoft"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:backgroundTint="@color/accent_soft"
                    android:text="+"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rows"
                    android:textColor="@color/ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/rowsMinus"
                    style="@style/CutGridPillSoft"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:backgroundTint="@color/surface"
                    android:text="−"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/rowsValue"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/rowsPlus"
                    style="@style/CutGridPillSoft"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:backgroundTint="@color/accent_soft"
                    android:text="+"
                    android:textSize="18sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/grid_drag_hint"
                    android:textColor="@color/ink_muted"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/resetGridButton"
                    style="@style/CutGridPillSoft"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/accent_soft"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/reset_grid"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selectPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/selectAllButton"
                    style="@style/CutGridPillSoft"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="@string/select_all" />

                <Button
                    android:id="@+id/clearSelectionButton"
                    style="@style/CutGridPillSoft"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface"
                    android:text="@string/clear_selection" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/saveSelectedButton"
                    style="@style/CutGridPillPrimary"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/save" />

                <Button
                    android:id="@+id/saveAllButton"
                    style="@style/CutGridPillSoft"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/save_all" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
