<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/projectSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/home_subtitle"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="138dp"
        android:layout_marginTop="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ScrollView
            android:id="@+id/thumbnailScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:visibility="gone">

            <GridLayout
                android:id="@+id/thumbnailGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="5" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/emptyPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/placeholder_dashed"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_empty_title"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/home_empty_hint"
                android:textColor="@color/ink_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <com.emrobinso.cutgridimages.ui.GridEditorView
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:background="@drawable/preview_background"
        android:contentDescription="@string/editor_description" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/modeGridButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:backgroundTint="@color/accent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/mode_grid"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/modeSelectButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/chip"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/mode_select"
                android:textColor="@color/ink"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gridControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="@string/columns"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <Button
                android:id="@+id/columnsMinus"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:backgroundTint="@color/chip"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="−"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/columnsValue"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <Button
                android:id="@+id/columnsPlus"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:backgroundTint="@color/chip"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="+"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/rows"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <Button
                android:id="@+id/rowsMinus"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:backgroundTint="@color/chip"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="−"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/rowsValue"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <Button
                android:id="@+id/rowsPlus"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:backgroundTint="@color/chip"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="+"
                android:textColor="@color/ink"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selectPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/selectAllButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/chip"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/select_all"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/clearSelectionButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/chip"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/clear_selection"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/saveSelectedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1.2"
                    android:backgroundTint="@color/accent"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/save"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/saveAllButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/chip"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/save_all"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
