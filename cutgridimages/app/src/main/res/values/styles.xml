<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tombol pil: bentuk membulat, warna diatur lewat backgroundTint. -->
    <style name="CutGridPill" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CutGridPillPrimary" parent="CutGridPill">
        <item name="android:backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/surface</item>
    </style>

    <style name="CutGridPillSoft" parent="CutGridPill">
        <item name="android:backgroundTint">@color/chip</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="CutGridPillDanger" parent="CutGridPill">
        <item name="android:backgroundTint">@color/danger</item>
        <item name="android:textColor">@color/surface</item>
    </style>

    <!-- Butang navigasi bawah: pil lembut, latar aktif diatur dari kode. -->
    <style name="CutGridNavItem" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Label kecil di atas isian. -->
    <style name="CutGridLabel">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="CutGridInput">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

</resources>
